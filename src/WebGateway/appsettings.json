{
  "Urls": "http://0.0.0.0:8080",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "system-route": {
        "ClusterId": "system-cluster",
        "Match": { "Path": "/api/system/{**catch-all}" }
      },
      "erp-route": {
        "ClusterId": "erp-cluster",
        "Match": { "Path": "/api/erp/{**catch-all}" }
      },
      "mes-route": {
        "ClusterId": "mes-cluster",
        "Match": { "Path": "/api/mes/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "system-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "erp-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5100/" } } },
      "mes-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5200/" } } }
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5001",
    "Audience": "api",
    "RequireHttpsMetadata": false
  }
}